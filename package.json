{
  "name": "orb-modpack-exporter",
  "productName": "ORB Modpack Exporter",
  "version": "2.1.5",
  "description": "Collaborate via GitHub, export .mrpack files, and track changes",
  "main": ".vite/build/index.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/OR-Beyond/modpack-exporter.git"
  },
  "homepage": "https://github.com/OR-Beyond/modpack-exporter#readme",
  "bugs": {
    "url": "https://github.com/OR-Beyond/modpack-exporter/issues"
  },
  "desktopName": "orb-modpack-exporter",
  "scripts": {
    "start": "bun run build && bunx electron .",
    "build:main": "bunx vite build --config vite.main.config.ts",
    "build:preload": "bunx vite build --config vite.preload.config.ts",
    "build:renderer": "bunx vite build --config vite.renderer.config.mts",
    "build": "bun run build:main && bun run build:preload && bun run build:renderer",
    "lint": "tsc -b",
    "typecheck": "tsc -b",
    "svelte-check": "bunx svelte-check --tsconfig ./tsconfig.renderer.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "bun run build && bunx electron-builder --config electron-builder.config.cjs --dir",
    "dist": "bun run build && bunx electron-builder --config electron-builder.config.cjs",
    "dev:sandbox": "ORB_SANDBOX=1 bun run build && ORB_SANDBOX=1 bunx electron .",
    "test:sandbox": "ORB_SANDBOX=1 bun run test",
    "i18n:check": "bun run scripts/i18n/check.ts",
    "i18n:lint": "bun run scripts/i18n/lint.ts",
    "i18n:new": "bun run scripts/i18n/new.ts",
    "i18n:stats": "bun run scripts/i18n/stats.ts",
    "release:prepare": "bun run scripts/release/prepare.ts",
    "release:tag": "bun run scripts/release/tag.ts",
    "release:rebuild": "bun run scripts/release/rebuild.ts",
    "release:retag": "bun run scripts/release/retag.ts",
    "release:status": "bun run scripts/release/status.ts"
  },
  "author": "ORB Team",
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "4.0.4",
    "@types/bun": "^1.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "10.6.1",
    "electron": "42.11.18",
    "electron-builder": "26.18.0",
    "eslint-plugin-svelte": "^3.23.1",
    "postcss": "8.5.31",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vite": "^5.4.21",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@lucide/svelte": "1.61.0",
    "@octokit/rest": "^21.1.1",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.18",
    "electron-store": "^8.2.0",
    "electron-updater": "6.8.11",
    "isomorphic-git": "1.44.3",
    "js-yaml": "4.3.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20",
    "bun": ">=1.4.2"
  },
  "type": "module"
}
