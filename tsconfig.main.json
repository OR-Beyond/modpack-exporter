{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@main/*": [
        "./src/main/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "vite.main.config.ts",
    "vite.preload.config.ts",
    "electron-builder.config.cjs"
  ]
}
